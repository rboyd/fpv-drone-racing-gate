# Preserve standard CSV CRLF records without treating them as whitespace errors.
*.csv whitespace=cr-at-eol

# Fabrication and visual artifacts are binary, including ASCII-encoded PDFs.
*.pdf binary
*.blend binary
*.3mf binary
*.stl binary
*.png binary
*.jpg binary
*.jpeg binary

# Keep downloaded standard license text byte-for-byte, including final blank lines.
LICENSE whitespace=-blank-at-eof
